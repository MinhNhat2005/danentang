rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Chi cho phep nguoi dung da dang nhap quan ly san pham.
    // Document products chi duoc co dung 4 truong theo de bai.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['name', 'price', 'soluong', 'image'])
        && request.resource.data.keys().hasOnly(['name', 'price', 'soluong', 'image'])
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.soluong is int
        && request.resource.data.image is string;
      allow update: if request.auth != null
        && request.resource.data.keys().hasAll(['name', 'price', 'soluong', 'image'])
        && request.resource.data.keys().hasOnly(['name', 'price', 'soluong', 'image'])
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.soluong is int
        && request.resource.data.image is string;
      allow delete: if request.auth != null;
    }
  }
}
